{
  "name": "dynamical-weather-bot",
  "version": "1.0.0",
  "type": "module",
  "description": "Probabilistic weather forecast powered by dynamical.org GEFS ensemble data",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:accuracy && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt src/",
    "fmt:check": "oxfmt --check src/",
    "lint": "oxlint src/ --deny-warnings",
    "test": "vitest run --coverage && playwright test",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate:accuracy": "tsx scripts/build-accuracy-grid.ts",
    "check": "npm run fmt:check && npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/proj4": "^2.5.6",
    "@vitest/coverage-v8": "^5.0.2",
    "hyparquet": "^1.31.1",
    "numcodecs": "^0.3.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.140.0"
  },
  "dependencies": {
    "hyparquet-compressors": "^1.1.2",
    "icechunk-js": "^0.6.0",
    "proj4": "^2.22.0",
    "zarrita": "^0.7.5"
  }
}
